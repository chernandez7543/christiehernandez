#include <iostream>
#include <vector>
#include <string>

using namespace std;

//Iterative Binary Search

int binarySearchIterative(vector <int> & arr, int target, int& comparisons){


int low = 0;
int high = arr.size() - 1;

comparisons = 0;

while (low <= high){

    int mid = low + (high - low) / 2;

    comparisons++;

    if (target == arr[mid]) 
        return mid; // Found target, return (exit)

    else if (target < arr[mid]) 
        high = mid-1; // target lies before mid
    else low = mid + 1; // target lies after mid

}
    return -1; //not found

}

//Recursive Binary Search
int binarySearchRecursive (vector <int> & arr, int low, int high, int target, int& comparisons){

    if (low > high) {
        return -1;
    }
    
    int mid = low + (high - low) / 2; 

    comparisons++;

    if (arr[mid] < target){
        return binarySearchRecursive(arr, mid + 1, high, target, comparisons);
    }
    comparisons++;

    if (arr[mid] > target) {
        return binarySearchRecursive(arr, low, mid-1, target, comparisons);
    }
    
    else {

    return mid;
    }
    return -1;
    
}
