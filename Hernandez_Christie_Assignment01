
#include <iostream>
#include <unordered_map>
#include <vector>
using namespace std;

std::pair<int, int> twoSumBruteForce(const std::vector<int>& nums, int target) {

    for (int i = 0; i < nums.size(); ++i) {
        for (int j = i + 1; j < nums.size(); ++j) {
            if (nums[i] + nums[j] == target) {
                return {i, j};
            }
        }
    }
    return {-1, -1};
}

;

// Complexity
// Brute Force:
// Time complexity:O(n^2) due to nested loops that compare the pairs 
// Space Complexity:O(1) due to no extra space used

// Hash:
// Time complexity: O(n) due to single loop
// Space complexity: O(n) due to using more memory as more numbers are being added

std::pair<int, int> twoSumHash(const std::vector<int>& nums, int target)
{
    std::unordered_map<int, int> mp;
    for (int i = 0; i < nums.size(); ++i) {
        int complement = target - nums[i];
        if (mp.count(complement)) {

            return {mp[complement], i};
        }
        mp[nums[i]] = i;
    }
    return {-1, -1};
}
