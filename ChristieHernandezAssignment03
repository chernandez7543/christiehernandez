    // isSorted

    bool isSorted(const vector<int>& values) {
        for (int i = 1; i < values.size(); i++) {

            if (values[i] < values[i - 1]) {
                return false;
            }
        }
        return true;
    }

    // Bubble Sort
void bubbleSort(vector<int>& values) {

            int length = values.size();
            bool swapped;

             for (int i = 0; i < length - 1; i++) {
                swapped = false;
             
             for (int j = 0; j < length - 1 - i; j++) {
            if (values[j] > values [j + 1]) {

                int swap = values[j];
                values[j] = values[j + 1];
                values[j + 1] = swap;
                
                swapped = true;
            }
        }
        if (!swapped) {
            break;
        }
    }
    }
    // Selection Sort

     void selectionSort(vector<int>& values) {
        int length = values.size();
        
        for (int i = 0; i < length - 1; i++) {
            int minPos = i;

        for (int j = i + 1; j < length; j++) {
            if (values[j] < values[minPos]) {
                minPos = j;
            }
        }
        if (minPos != i) {
            int temp = values[i];
                values[i] = values[minPos];
                values[minPos] = temp;
            }
        }
     }
     // Insertion Sort
        
        void insertionSort(vector<int>& values) {
            int length = values.size();

            for (int i = 1; i <length; i++) {

            int key = values[i];
            int j = i - 1;

            while (j >= 0 && values[j] > key) {
                values[j + 1] = values[j];
                j--;
            }
    
            values[j + 1] = key;
            }
        }
        // Quick Sort  

        void quickSort(vector <int>& values) {

            if (values.size() > 1) {
                quickSortRecursion(values, 0, values.size() -1);
            
            }
        }
    void quickSortRecursion(vector<int>& values, int low, int high) {
        if (low < high) {
            
        int pivotIndex = partition(values, low, high);

       quickSortRecursion(values, low, pivotIndex - 1);
       quickSortRecursion(values, pivotIndex + 1, high);

        }
    }

    int partition(vector<int>& values, int low, int high){

        int pivotValue = values[high];
        int i = low;
        
        for (int j = low; j < high; j++) {
            if (values[j] <= pivotValue) {
               int temp = values[i];
               values[i] = values[j];
               values[j] = temp;

               i++;
            }
        }
        int temp = values[i];
        values[i] = values[high];
        values[high] = temp;

        return i;
    }
