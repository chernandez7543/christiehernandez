    check(d.peekBack(x) && x == 30, "Peek back = 30");
    check(d.popFront(x) && x == 0, "07 popFront -> 0");
    check(d.popBack(x) && x == 30, "08 popBack -> 30");
    check(d.pushFront(3), "09 pushFront 3");         // [3,1,5,10,20]
    check(d.pushBack(40), "10 pushBack 40");         // [3,1,5,10,20,40]
    d.print();
    check(d.popFront(x) && x == 3, "11 popFront -> 3");
    check(d.popBack(x) && x == 40, "12 popBack -> 40");
    check(d.popFront(x) && x == 1, "13 popFront -> 1");
    check(d.popBack(x) && x == 20, "14 popBack -> 20");
    check(d.popFront(x) && x == 5, "15 popFront -> 5");
