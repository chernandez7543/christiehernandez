void testArrayDeque() {
    heading("5. Array Deque (both ends, circular)");
    ArrayDeque d;
    int x = -1;
    check(d.isEmpty(), "Initially empty");
    check(d.pushBack(10), "01 pushBack 10");          // [10]
    check(d.pushFront(5), "02 pushFront 5");          // [5,10]
    check(d.pushBack(20), "03 pushBack 20");          // [5,10,20]
    check(d.pushFront(1), "04 pushFront 1");          // [1,5,10,20]
    check(d.pushBack(30), "05 pushBack 30");          // [1,5,10,20,30]
    d.print();
    check(!d.pushFront(0), "06 pushFront rejected (array full)");
    check(d.peekFront(x) && x == 1, "Peek front = 1");
    check(d.peekBack(x) && x == 30, "Peek back = 30");
    check(d.popFront(x) && x == 1, "07 popFront -> 1"); // [5,10,20,30]
    check(d.popBack(x) && x == 30, "08 popBack -> 30");// [5,10,20]
    check(d.pushFront(3), "09 pushFront 3");         // [3,5,10,20]
    check(d.pushBack(40), "10 pushBack 40");         // [3,5,10,20,40]
    d.print();
    check(d.popFront(x) && x == 3, "11 popFront -> 3");
    check(d.popFront(x) && x == 5, "12 popFront -> 5");
    check(d.popBack(x) && x == 40, "13 popBack -> 40");
    check(d.popFront(x) && x == 10, "14 popFront -> 10");
    check(d.popBack(x) && x == 20, "15 popBack -> 20");
    check(!d.popBack(x), "16 popBack rejected (empty deque)");
    check(d.isEmpty(), "Ends empty");
    d.print();
}

void testLinkedDeque() {
    heading("6. Linked Deque (doubly linked)");
    LinkedDeque d;
    int x = -1;
    check(d.isEmpty(), "Initially empty");
    check(d.pushBack(10), "01 pushBack 10");         // [10]
    check(d.pushFront(5), "02 pushFront 5");         // [5,10]
