void testArrayQueue() {
    heading("3. Array Queue (FIFO, circular)");
    ArrayQueue q;
    int x = -1;
    check(q.isEmpty(), "Initially empty");
    check(q.enqueue(10), "01 enqueue 10");
    check(q.enqueue(20), "02 enqueue 20");
    check(q.enqueue(30), "03 enqueue 30");
    check(q.enqueue(40), "04 enqueue 40");
    check(q.enqueue(50), "05 enqueue 50");
    q.print();
    check(!q.enqueue(60), "06 enqueue 60 rejected (array is full)");
    check(q.peek(x) && x == 10, "Peek shows front = 10");
    check(q.dequeue(x) && x == 10, "07 dequeue -> 10");
    check(q.dequeue(x) && x == 20, "08 dequeue -> 20");
    check(q.enqueue(60), "09 enqueue 60 (wrap-around)");
    check(q.enqueue(70), "10 enqueue 70 (wrap-around)");
    q.print();
    check(q.dequeue(x) && x == 30, "11 dequeue -> 30");
    check(q.dequeue(x) && x == 40, "12 dequeue -> 40");
    check(q.dequeue(x) && x == 50, "13 dequeue -> 50");
    check(q.dequeue(x) && x == 60, "14 dequeue -> 60");
    check(q.dequeue(x) && x == 70, "15 dequeue -> 70");
    check(!q.dequeue(x), "16 dequeue rejected (empty queue)");
    check(q.isEmpty(), "Ends empty");
    q.print();
}

