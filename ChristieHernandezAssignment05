    d.print();

}
int main() {
    
    cout << "Array capacity = " << CAPACITY << "\n";
    cout << "Every numbered line is an insertion or removal attempt.\n";

    testArrayStack();
    testLinkedStack();
    testArrayQueue();
    testLinkedQueue();
    testArrayDeque();
